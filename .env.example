# Open Relay Portal Configuration
# Copy this to .env and customize

# JWT secret key - CHANGE THIS IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Server settings
HOST=0.0.0.0
PORT=443
HOSTNAME=portal.example.com

# SSL certificate paths
# Use 'python server.py setup' to configure automatically
SSL_CERT=/etc/letsencrypt/live/portal.example.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/portal.example.com/privkey.pem

# Certificate method: letsencrypt, selfsigned, custom
# Set automatically by 'python server.py setup' or admin panel
CERT_METHOD=
CERT_EMAIL=

# Database path
DATABASE_PATH=/opt/portal/portal.db

# Token settings
TOKEN_EXPIRY_HOURS=720

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Manager
# Root directory for admin file browser (default: /)
# FILE_MANAGER_ROOT=/
# Max upload size in MB (default: 100)
# FILE_MANAGER_MAX_UPLOAD_MB=100
