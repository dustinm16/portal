# Open Relay Portal Configuration
# Copy this to .env and customize

# JWT secret key - CHANGE THIS IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Server settings
HOST=0.0.0.0
PORT=443
HOSTNAME=portal.example.com

# SSL certificate paths (Let's Encrypt default locations)
SSL_CERT=/etc/letsencrypt/live/portal.example.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/portal.example.com/privkey.pem

# Database path
DATABASE_PATH=/opt/portal/portal.db

# Token settings
TOKEN_EXPIRY_HOURS=720

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
