# Open Relay Portal Configuration
# RECOMMENDED: Run 'sudo python server.py setup' instead of editing this manually.
# The setup wizard auto-generates certs, JWT secret, and all paths.
#
# Manual setup: Copy this to .env and customize the values below.
# After creating .env, restrict permissions: chmod 600 .env

# =============================================================================
# REQUIRED
# =============================================================================

# JWT secret key - MUST be unique per install
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Server hostname (your domain or IP)
# IMPORTANT: You must set this explicitly. On Linux, $HOSTNAME is a system
# variable (your machine name), so omitting this will NOT default to "localhost".
HOSTNAME=localhost

# SSL certificate paths
# Run 'sudo python server.py setup' to auto-generate a self-signed cert,
# or set these to your own certificate files.
# Without valid cert/key files the server will not start.
SSL_CERT=certs/selfsigned_cert.pem
SSL_KEY=certs/selfsigned_key.pem

# =============================================================================
# SERVER
# =============================================================================

HOST=0.0.0.0
PORT=443

# Certificate method: selfsigned, letsencrypt, custom
# Set automatically by setup wizard or admin panel
CERT_METHOD=selfsigned
# CERT_EMAIL=                          # Email for Let's Encrypt notifications

# Database path (relative to project dir or absolute)
# DATABASE_PATH=portal.db

# Token expiry in hours (default: 720 = 30 days)
# TOKEN_EXPIRY_HOURS=720

# =============================================================================
# STREAMING
# =============================================================================

# Separate hostname for RTMPS ingress (defaults to HOSTNAME)
# Use this when RTMPS should bypass a CDN like Cloudflare
# STREAM_HOSTNAME=stream.example.com

# Plain RTMP (non-TLS) ingress — disabled by default
# RTMP_PLAIN_ENABLED=false
# RTMP_PLAIN_PORT=1935
# RTMP_TOKEN_EXPIRY_MINUTES=15         # Temporary token lifetime
# RTMP_TOKEN_GRACE_SECONDS=30          # Grace period after token use

# Session recordings directory
# RECORDINGS_DIR=recordings
# RECORDING_ENABLED=true

# =============================================================================
# VOICE CHAT (WebRTC)
# =============================================================================

# STUN server for NAT traversal
# STUN_SERVER=stun:stun.l.google.com:19302

# TURN server for relaying (needed when direct P2P fails behind strict NAT)
# TURN_SERVER=
# TURN_USERNAME=
# TURN_PASSWORD=

# =============================================================================
# RATE LIMITING
# =============================================================================

# Max requests per IP per window
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60                 # Window in seconds

# =============================================================================
# SESSION COOKIES
# =============================================================================

# SESSION_COOKIE_NAME=portal_session
# SESSION_COOKIE_MAX_AGE=86400         # 24 hours
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# TWO-FACTOR AUTHENTICATION
# =============================================================================

# Issuer name shown in authenticator apps
# TOTP_ISSUER=Open Relay Portal

# =============================================================================
# TRAFFIC & SECURITY
# =============================================================================

# Traffic metrics
# METRICS_ENABLED=true
# METRICS_RETENTION_HOURS=24

# Shodan integration (optional — for exposure scanning)
# SHODAN_API_KEY=

# Vulnerability scanner (optional)
# NVD_API_KEY=                         # NVD API key for CVE lookups
# NMAP_PATH=/usr/bin/nmap
# CVE_CACHE_TTL=3600                   # Cache TTL in seconds
# VULN_SCAN_TIMEOUT=300                # Scan timeout in seconds

# =============================================================================
# FILE MANAGER
# =============================================================================

# Root directory for admin file browser (default: /)
# FILE_MANAGER_ROOT=/
# Max upload size in MB (default: 100)
# FILE_MANAGER_MAX_UPLOAD_MB=100

# =============================================================================
# SEO / SEARCH ENGINE VERIFICATION
# =============================================================================

# Google Search Console (optional)
# GOOGLE_SITE_VERIFICATION=              # Meta tag verification code
# GOOGLE_VERIFICATION_FILE=              # File verification ID (filename part after 'google')
