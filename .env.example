# Open Relay Portal Configuration
# RECOMMENDED: Run 'sudo python server.py setup' instead of editing this manually.
# The setup wizard auto-generates certs, JWT secret, and all paths.
#
# Manual setup: Copy this to .env and customize the values below.
# After creating .env, restrict permissions: chmod 600 .env

# =============================================================================
# REQUIRED
# =============================================================================

# JWT secret key - MUST be unique per install
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Server hostname (your domain or IP)
# IMPORTANT: You must set this explicitly. On Linux, $HOSTNAME is a system
# variable (your machine name), so omitting this will NOT default to "localhost".
HOSTNAME=localhost

# SSL certificate paths
# Run 'sudo python server.py setup' to auto-generate a self-signed cert,
# or set these to your own certificate files.
# Without valid cert/key files the server will not start.
SSL_CERT=certs/selfsigned_cert.pem
SSL_KEY=certs/selfsigned_key.pem

# =============================================================================
# SERVER
# =============================================================================

HOST=0.0.0.0
PORT=443

# Certificate method: selfsigned, letsencrypt, custom
# Set automatically by setup wizard or admin panel
CERT_METHOD=selfsigned
# CERT_EMAIL=                          # Email for Let's Encrypt notifications

# Database path (relative to project dir or absolute)
# DATABASE_PATH=portal.db

# Token expiry in hours (default: 720 = 30 days)
# TOKEN_EXPIRY_HOURS=720

# =============================================================================
# STREAMING
# =============================================================================

# Separate hostname for RTMPS ingress (defaults to HOSTNAME)
# Use this when RTMPS should bypass a CDN like Cloudflare
# STREAM_HOSTNAME=stream.example.com

# Base address used for the watch link in go-live announcements (https://host[:port], no path);
# when unset it is https:// plus HOSTNAME. A malformed value gives announcements no link at all.
# PUBLIC_BASE_URL=https://portal.example.com

# Plain RTMP (non-TLS) ingress — disabled by default
# RTMP_PLAIN_ENABLED=false
# RTMP_PLAIN_PORT=1935
# RTMP_TOKEN_EXPIRY_MINUTES=15         # Temporary token lifetime
# RTMP_TOKEN_GRACE_SECONDS=300         # Grace period after token use (seconds)

# Session recordings directory
# RECORDINGS_DIR=recordings           # created 0700, files 0600; each recording stops at 50 MB
# RECORDING_ENABLED=true

# Local staging folder for VOD chunks that are waiting to be uploaded to the
# owner's SFTP storage (default: data/vod_tmp in the project folder, mode 0700).
# A relative value is resolved against the project folder. A folder outside the
# project must be writable by the portal's service.
# Refused (logged, the folder is left untouched, the default is used instead):
# anything at or below /tmp or /var/tmp (a service with PrivateTmp loses it on
# every restart), the filesystem root, a mount point itself (use a sub-directory
# of the mount), a home directory, the project folder, a symlink, and a
# non-empty folder the portal did not create. If no folder is usable, VOD
# recording is off until it is fixed; the streams themselves are not affected.
# The old /tmp/portal_vods is moved in on start only where the portal sees the
# real /tmp, which a PrivateTmp service does not (move such chunks by hand).
# Chunks that can never be delivered (no session record, or the owner is gone
# or has no VOD storage) are deleted after vod_orphan_max_age_days (Admin >
# Settings > Data Retention, default 14 days, 0 = never).
# A new recording is not started, and a running one is stopped, when less than
# vod_min_free_gb (default 1 GB, 0 = off) is free there or when one streamer's
# chunks waiting for upload exceed vod_max_backlog_gb (default 2 GB, 0 = off).
# VOD_TEMP_DIR=data/vod_tmp

# Folder for the MP4 and HLS copies that the browser plays from My VODs (Play),
# default data/vod_play_cache in the project folder, mode 0700. Its size is
# capped by the setting vod_play_cache_mb (Admin > Settings > Data Retention,
# default 512 MB, 0 = playback off). A relative value is resolved against the
# project folder. The checks for VOD_TEMP_DIR apply (nothing at or below /tmp
# or /var/tmp, not the filesystem root, a mount point itself, a home directory
# or the project folder, no symlink), and also: not a folder the web server
# serves, not owned by another user, not non-empty unless the portal made it,
# and it may not be, contain or lie inside the VOD staging folder or
# RECORDINGS_DIR. A refused folder turns browser playback off, with a line in
# the log; recording and streams are not affected. Update snapshots skip it
# and a rollback empties it.
# VOD_PLAY_CACHE_DIR=data/vod_play_cache

# Local web-terminal shells run in their own systemd scope, so tmux/screen
# sessions started from the terminal survive a portal restart. Set to false
# to keep them inside the portal's own service group (killed on restart).
# TERMINAL_OWN_SCOPE=true

# =============================================================================
# VOICE CHAT (WebRTC)
# =============================================================================

# STUN server for NAT traversal
# STUN_SERVER=stun:stun.l.google.com:19302

# TURN server for relaying (needed when direct P2P fails behind strict NAT)
# TURN_SERVER=
# TURN_USERNAME=
# TURN_PASSWORD=

# =============================================================================
# RATE LIMITING
# =============================================================================

# Max requests per IP per window
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60                 # Window in seconds

# Reverse proxies allowed to set the client IP (CF-Connecting-IP /
# X-Forwarded-For). Cloudflare is always trusted; add your own proxy or load
# balancer here as comma-separated IPs/CIDRs. A reverse proxy or cloudflared
# running on this host needs 127.0.0.1,::1 listed. Headers from any other
# peer are ignored, so direct-to-origin clients cannot spoof their IP.
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.5

# Optional (off by default): block clients requesting scanner-only paths
# (.env, .git/config, *.php, ...) for a while after this many hits. Only
# non-browser requests count, and local addresses and this server's own IPs
# are never blocked. Blocks are per IP, so everyone behind one NAT shares
# them. They are held in memory and not listed in the admin panel: lift one
# with DELETE /api/admin/blocked-ips/<ip> (admin), or restart the portal to
# clear them all. 3 is a reasonable value; 0 disables.
# PROBE_BLOCK_STRIKES=0
# PROBE_BLOCK_SECONDS=3600

# Addresses and networks that are never blocked automatically (scanner
# blocking and any other automatic block), comma separated. Loopback, private
# and link-local addresses, this host's own addresses, trusted proxies and
# Cloudflare are always exempt; add your own home or office address here.
# Nothing broader than /8 (IPv4) or /16 (IPv6) is accepted. Works without the
# database, so it still applies if the database is lost. A list can also be
# edited in Admin > Settings > Never-ban list. Example (a documentation range):
# NEVER_BAN_CIDRS=203.0.113.0/24

# =============================================================================
# SESSION COOKIES
# =============================================================================

# SESSION_COOKIE_NAME=portal_session
# SESSION_COOKIE_MAX_AGE=86400         # 24 hours
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# TWO-FACTOR AUTHENTICATION
# =============================================================================

# Issuer name shown in authenticator apps
# TOTP_ISSUER=Open Relay Portal

# =============================================================================
# TRAFFIC & SECURITY
# =============================================================================

# Traffic metrics
# METRICS_ENABLED=true
# METRICS_RETENTION_HOURS=24

# Shodan integration (optional — for exposure scanning)
# SHODAN_API_KEY=

# Vulnerability scanner (optional)
# NVD_API_KEY=                         # NVD API key for CVE lookups
# NMAP_PATH=/usr/bin/nmap
# CVE_CACHE_TTL=3600                   # Cache TTL in seconds
# VULN_SCAN_TIMEOUT=300                # Scan timeout in seconds

# =============================================================================
# FILE MANAGER
# =============================================================================

# Root directory for admin file browser (default: /)
# FILE_MANAGER_ROOT=/
# Max upload size in MB (default: 100)
# FILE_MANAGER_MAX_UPLOAD_MB=100

# =============================================================================
# SEO / SEARCH ENGINE VERIFICATION
# =============================================================================

# Google Search Console (optional)
# GOOGLE_SITE_VERIFICATION=              # Meta tag verification code
# GOOGLE_VERIFICATION_FILE=              # File verification ID (filename part after 'google')

# Bing Webmaster Tools (optional)
# BING_SITE_VERIFICATION=                # Meta tag verification code from Bing Webmaster

# Yandex Webmaster (optional)
# YANDEX_SITE_VERIFICATION=              # Meta tag verification code from Yandex Webmaster

# IndexNow - Instant indexing for Bing, Yandex, Seznam, Naver (optional)
# Generate a key at https://www.indexnow.org/ or use any 32-char hex string
# INDEXNOW_API_KEY=                       # API key for IndexNow protocol

# =============================================================================
# GAME SERVERS (optional — only needed to use the Game Servers admin tab)
# =============================================================================

# Required to deploy/manage any game server. The Linux account game servers
# run as — never the account Portal itself runs as (Portal is typically root;
# game servers should not be). This account needs passwordless sudo access for
# Portal (running as root) to manage it, and NOPASSWD sudo -u <this account>
# for Portal to run steamcmd/the game process as it.
# PORTAL_GAMESERVER_USER=

# steamcmd.sh location. Optional — defaults to
# <PORTAL_GAMESERVER_USER's home>/steamcmd/steamcmd.sh (Valve's own documented
# install layout). Set this only if steamcmd lives somewhere else.
# PORTAL_STEAMCMD=

# Default game-data disk/directory for newly deployed servers (default:
# /mnt/gamedata). This becomes the seed value for the first row of the
# admin-managed storage-roots list (Admin > Game Servers > Storage Locations)
# — additional locations can be added from there without touching this file.
# PORTAL_GAMEDATA_ROOT=/mnt/gamedata

# Wine binary for Windows-only servers. Debian's wine64 is installed automatically
# at this default path; set this to use your own Wine, for example one that can
# run 32-bit servers. See docs/WINDOWS-GAME-SERVERS.md.
# PORTAL_WINE_BIN=/usr/lib/wine/wine64

# Extra directories (besides a storage root and Project Zomboid's ~/Zomboid)
# that a game's config_root may point at — colon-separated absolute paths.
# Narrow, advanced escape hatch for a catalog game that keeps its config
# outside its install dir the way Zomboid does; most games never need this.
# PORTAL_GS_EXTRA_CONFIG_ROOTS=

# =============================================================================
# STAGED TEST INSTANCE (FOR TESTING ONLY - NEVER SET IN PRODUCTION)
# =============================================================================

# Set to 1 only by tools/stage_smoke.py, which runs a throwaway copy of the
# portal. It turns off every side effect on the host: managed-service
# autostart, outgoing webhooks, the update and rollback actions, game-server
# background work and MediaMTX polling. The server refuses to start with it
# unless HOST=127.0.0.1 and PORT is not 80 or 443. Leave it unset here.
# PORTAL_STAGE_MODE=1
