[Unit]
Description=Portal Gateway - WebSocket Auth and Relay Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/dustin/scripts/portal
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/dustin/scripts/portal/venv/bin/python /home/dustin/scripts/portal/server.py serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Allow binding to privileged ports
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portal

[Install]
WantedBy=multi-user.target
